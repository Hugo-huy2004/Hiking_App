{
  "name": "hugohiking",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:ios": "cd ios && pod install && cd .. && npx expo run:ios --device 'iPhone 16 Pro'",
    "build:android": "npx expo run:android",
    "dev:both": "bash scripts/launch.sh",
    "dual": "bash scripts/launch.sh",
    "prebuild": "npx expo prebuild",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.2",
    "@react-native-async-storage/async-storage": "^1.20.1",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "expo": "~57.0.0",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.2",
    "expo-crypto": "~57.0.1",
    "expo-font": "~57.0.0",
    "expo-image-picker": "~57.0.7",
    "expo-linking": "~57.0.1",
    "expo-location": "~57.0.7",
    "expo-router": "~57.0.2",
    "expo-splash-screen": "~57.0.1",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.15",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^57.0.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3"
  }
}
