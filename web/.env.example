# Cùng Realtime Database với bản Android (xem API_BASE_URL trong .env ở thư mục gốc repo)
VITE_API_BASE_URL=https://YOUR-PROJECT-default-rtdb.asia-southeast1.firebasedatabase.app
# Cùng OAuth client id với Android (strings.xml > server_client_id) -> sub giống nhau -> chung node
VITE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
VITE_AUTHOR=Your Name
VITE_APP_VERSION=1.0.0
