# --- Firebase Realtime Database (chung với bản web + Android) ---
EXPO_PUBLIC_API_BASE_URL=https://YOUR-PROJECT-default-rtdb.asia-southeast1.firebasedatabase.app

# --- Google OAuth ---
# Cả ba tạo trong CÙNG một Google Cloud project thì `sub` trong id_token giống nhau
# -> web và native cùng đọc/ghi node users/{sub}.
#   Web    : dùng cho bản web (Google Identity Services) + làm audience cho id_token
#   iOS    : loại "iOS", nhập Bundle ID = com.legiahu.mhike  (xem app.config.js)
#   Android: loại "Android", nhập Package = com.legiahu.mhike + SHA-1 của keystore
EXPO_PUBLIC_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxxx.apps.googleusercontent.com

EXPO_PUBLIC_AUTHOR=Your Name
EXPO_PUBLIC_APP_VERSION=1.0.0
